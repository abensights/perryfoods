rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidOrder(data) {
      return data.orderNo is string && data.orderNo.size() <= 64 &&
             data.customerName is string && data.customerName.size() <= 128 &&
             data.totalAmountBirr is number &&
             data.itemsSummary is string && data.itemsSummary.size() <= 1000;
    }

    match /orders/{orderId} {
      // Anyone can place an order from the website
      allow create: if isValidOrder(request.resource.data);
      // Anyone can track and read orders by ID, name, or phone number
      allow read: if true;
      // Allow syncing order status updates from Google Sheet
      allow update: if request.resource.data.orderNo == resource.data.orderNo;
      allow delete: if false;
    }
  }
}
